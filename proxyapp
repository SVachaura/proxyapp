<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>ProxyApp</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  width:100%;
  height:100%;
  font-family:Arial,Helvetica,sans-serif;
  background:#fff;
  color:#111;
}

body{
  display:flex;
  justify-content:center;
  align-items:center;
}

.app{
  width:100%;
  max-width:430px;
  min-height:100vh;
  padding:25px 20px;
  display:flex;
  flex-direction:column;
}

.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:25px;
  font-weight:800;
  letter-spacing:-1px;
}

.settings{
  width:42px;
  height:42px;
  border:2px solid #111;
  background:#fff;
  font-size:20px;
  cursor:pointer;
}

.center{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
}

.status{
  font-size:15px;
  font-weight:700;
  margin-bottom:25px;
  text-transform:uppercase;
}

.connect{
  width:210px;
  height:210px;
  border-radius:50%;
  border:4px solid #111;
  background:#fff;
  font-size:20px;
  font-weight:800;
  cursor:pointer;
  transition:.2s;
}

.connect:active{
  transform:scale(.94);
}

.connect.connected{
  background:#111;
  color:#fff;
}

.server{
  margin-top:35px;
  width:100%;
  border:2px solid #111;
  padding:18px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  cursor:pointer;
}

.server-title{
  font-weight:800;
}

.server-name{
  margin-top:4px;
  color:#666;
  font-size:14px;
}

.arrow{
  font-size:22px;
}

.footer{
  text-align:center;
  font-size:12px;
  color:#777;
  padding:15px 0 5px;
}

@media(max-height:650px){
  .connect{
    width:170px;
    height:170px;
  }
}
</style>
</head>

<body>

<div class="app">

  <div class="header">
    <div class="logo">ProxyApp</div>
    <button class="settings">⚙</button>
  </div>

  <div class="center">

    <div class="status" id="status">
      Отключено
    </div>

    <button class="connect" id="connect">
      ПОДКЛЮЧИТЬ
    </button>

    <div class="server">
      <div>
        <div class="server-title">Сервер</div>
        <div class="server-name" id="server">
          Не выбран
        </div>
      </div>

      <div class="arrow">›</div>
    </div>

  </div>

  <div class="footer">
    ProxyApp
  </div>

</div>

<script>

const button = document.getElementById("connect");
const status = document.getElementById("status");

let connected = false;

button.addEventListener("click", () => {

  connected = !connected;

  if(connected){

    status.textContent = "Подключено";
    button.textContent = "ОТКЛЮЧИТЬ";
    button.classList.add("connected");

  }else{

    status.textContent = "Отключено";
    button.textContent = "ПОДКЛЮЧИТЬ";
    button.classList.remove("connected");

  }

});

</script>

</body>
</html>
